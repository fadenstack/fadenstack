.env
.empty-hf-cache/
.bootstrap-credentials
# RabbitMQ's users (password hashes) and the snippet that loads them: written by
# faden deploy, upgrade and dev from .env (cli/src/faden_cli/core/rmq.py).
rabbitmq/definitions.json
rabbitmq/10-faden.conf
# Backups made by faden backup / upgrade: database dumps and .env copies.
backups/
# The edge certificate and key nginx serves HTTPS with (docs/installing.md,
# "Enabling HTTPS"); only tls/README.md is tracked.
tls/*.crt
tls/*.key
tls/*.pem
# The certificate authority faden tls generate makes; its key never leaves this machine.
tls-ca/
# The CLI's note of this host's addresses and ports for the backend (faden tls, ports).
tls/edge.json
# Output of the daily jobs (faden tls renew).
logs/
# Put down by faden upgrade / faden maintenance on while the platform is down
# for maintenance; nginx answers with maintenance.html while it exists.
nginx/maintenance.flag
# faden upgrade / deploy note which commit this checkout's images were built from (faden version).
.faden-build
