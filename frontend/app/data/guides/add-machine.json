      "action": true
    },
    {
      "id": "command",
      "target": "[data-tour-id='nodes.onboard.command']",
      "placement": "left",
      "dialog": true,
      "waitMs": 5000
    },
    {
      "id": "approve",
      "target": "[data-tour-id='nodes.onboard.waiting']",
      "placement": "left",
      "dialog": true
    },
    {
      "id": "unattended",
      "target": "[data-tour-id='nodes.onboard.skip']",
      "placement": "left",
      "dialog": true
    }
  ]
}
