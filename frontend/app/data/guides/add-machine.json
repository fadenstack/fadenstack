{
  "id": "add_machine",
  "kind": "howto",
  "version": 2,
  "icon": "Dns",
  "route": "/admin/nodes",
  "requires": {
    "superuser": true
  },
  "steps": [
    {
      "id": "open",
      "target": "[data-tour-id='nodes.add']",
