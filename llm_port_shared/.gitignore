.env
.empty-hf-cache/
.bootstrap-credentials
rabbitmq/definitions.json
# Backups made by llmport backup / upgrade: database dumps and .env copies.
backups/
# The edge certificate and key nginx serves HTTPS with (docs/installing.md,
# "Enabling HTTPS"); only tls/README.md is tracked.
tls/*.crt
tls/*.key
tls/*.pem
# The certificate authority llmport tls generate makes; its key never leaves this machine.
tls-ca/
# The CLI's note of this host's addresses and ports for the backend (llmport tls, ports).
tls/edge.json
# Output of the daily jobs (llmport tls renew).
logs/
